# TikTok Shop Partner Center -> App details page
TTS_APP_KEY=
TTS_APP_SECRET=

# Must exactly match the Redirect URL configured on the app in Partner Center.
# `npm run auth` also accepts a pasted callback URL, so this can be a remote
# https URL you cannot serve locally.
TTS_REDIRECT_URI=http://localhost:5599/callback

# Local listener port used by `npm run auth`.
TTS_AUTH_PORT=5599

# Global API gateway. Override only if Partner Center gives you another host.
TTS_BASE_URL=https://open-api.tiktokglobalshop.com

# Auth service host (token get/refresh). Not signed.
TTS_AUTH_BASE_URL=https://auth.tiktok-shops.com

DB_PATH=./data/dashboard.db
